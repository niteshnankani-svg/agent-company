# Copy to .env (never commit .env) and set real values. Nothing here is a secret as written.
# Every external address is read from the environment; there are no built-in defaults.
# A department whose address is unset returns "failed: not_configured" instead of crashing.

# ---- Department services (see docs/SERVICES.md) -------------------------------------------
LEGAL_QUERY_URL=https://your-legal-rag.example/query
HR_AGENT_QUERY_URL=https://your-hr-agent.example/query
TICKETING_URL=https://your-ticketing-agent.example/ticket
NIRYAT_CHAT_URL=https://backend-production-a3c6.up.railway.app/chat
NIRYAT_TRADEDATA_URL=https://backend-production-a3c6.up.railway.app/tradedata
# Seconds to wait for each service (defaults shown):
# LEGAL_TIMEOUT_SECONDS=60
# HR_AGENT_TIMEOUT_SECONDS=60
# TICKETING_TIMEOUT_SECONDS=30
# NIRYAT_CHAT_TIMEOUT_SECONDS=60
# NIRYAT_TRADEDATA_TIMEOUT_SECONDS=90
# Upper bound for one whole department attempt (must exceed the sum of its service timeouts):
# DEPARTMENT_TIMEOUT_SECONDS=180
# /ready probes each service; to probe a different URL than the one requests use, set <NAME>_PROBE_URL, e.g.
# HR_AGENT_QUERY_URL_PROBE_URL=https://your-hr-agent.example/health

# ---- Routing, extraction and verification models -------------------------------------------
TYPESAFE_API_KEY=
# AWS credentials for Bedrock come from the usual AWS environment/role (AWS_ACCESS_KEY_ID, ... or an IAM role).
# BEDROCK_REGION=us-east-1
# ROUTER_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# EXTRACTION_MODEL_ID=   # defaults to ROUTER_MODEL_ID
# VERIFIER_MODEL_ID=     # defaults to ROUTER_MODEL_ID
# VERIFIER_ON_UNAVAILABLE=escalate   # or release_unchecked (degraded mode; answers are labelled unchecked)

# ---- Storage (runs waiting for a person survive restarts) -----------------------------------
# CHECKPOINT_DB_PATH=data/checkpoints.sqlite
# CHECKPOINT_DB_URL=postgresql://user:password@host:5432/agent   # set this to use Postgres instead (see requirements-postgres.txt)

# ---- Answer cache (off unless a provider is set) --------------------------------------------
# EMBEDDING_PROVIDER=bedrock   # or local
# CACHE_TTL_SECONDS=86400
# CACHE_SIMILARITY_THRESHOLD=0.95

# ---- API access ------------------------------------------------------------------------------
# name:role:key, comma separated. Roles: client (submit requests, look up a run) and reviewer (also list and
# decide reviews; the name is recorded as the reviewer). Keys must be at least 24 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS=console:client:CHANGE_ME_LONG_RANDOM,asha:reviewer:CHANGE_ME_LONG_RANDOM_TOO
# For local development only, to switch authentication off explicitly:
# AGENT_AUTH_DISABLED=true
