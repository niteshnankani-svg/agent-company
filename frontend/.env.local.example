# Point this at a reachable Agent Company API to run against the real model.
# Leave it unset (or set NEXT_PUBLIC_DEMO_MODE=1) to use the built-in demo,
# which replays captured /request responses with no backend.
NEXT_PUBLIC_API_BASE_URL=http://<AGENT_COMPANY_IP>:8080

# Force the offline demo even when an API URL is set:
# NEXT_PUBLIC_DEMO_MODE=1
