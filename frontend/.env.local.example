# Address of the Agent Company Python API (the FastAPI app in the repo root).
# Required: the console has no fallback and shows an error if this is unset or unreachable.
AGENT_COMPANY_API_URL=http://localhost:8080

# The API key the console uses. It must be a key with role "client" (see API_KEYS in the API's .env.example).
# It is used only by the server-side routes and is never sent to the browser.
AGENT_COMPANY_API_KEY=

# Optional: how long to wait for the API before giving up (milliseconds, default 55000).
# AGENT_COMPANY_TIMEOUT_MS=55000
